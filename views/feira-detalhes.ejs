<%- include('partials/header') %>

<% if (!feira) { %>
  <div style="text-align: center; padding: 4rem 1rem;">
    <h2>Feira não encontrada</h2>
    <p style="color: var(--text-secondary); margin: 1rem 0;">A feira solicitada não existe ou foi removida.</p>
    <a href="/agenda" class="btn btn-primary">Ver Todas as Feiras</a>
  </div>
<% } else { %>
  <% 
    let badgeClass = 'badge-default';
    const cat = (feira.categoria_nome || '').toLowerCase();
    if (cat.includes('artesanato')) badgeClass = 'badge-artesanato';
    else if (cat.includes('alimento')) badgeClass = 'badge-alimentos';
    else if (cat.includes('moda')) badgeClass = 'badge-moda';
    else if (cat.includes('cultural') || cat.includes('evento')) badgeClass = 'badge-eventos-culturais';
  %>

  <div style="margin: 2rem 0;">
    <div style="margin-bottom: 1.25rem;">
      <a href="/agenda" style="color: var(--text-secondary); font-size: 0.95rem;">&larr; Voltar para a Agenda</a>
    </div>

    <div class="detalhes-header">
      <div class="detalhes-top">
        <div>
          <span class="badge-categoria <%= badgeClass %>" style="display: inline-block; margin-bottom: 0.75rem;">
            <%= feira.categoria_nome %>
          </span>
          <h1 style="font-size: 2.2rem; font-weight: 800; color: var(--text-primary);"><%= feira.nome %></h1>
        </div>

        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
          <% if (locals.user && locals.user.isAdmin) { %>
            <a href="/feiras/editar/<%= feira.id %>" class="btn btn-secondary">
              ✏️ Editar Feira
            </a>
          <% } %>

          <% if (locals.user) { %>
            <% if (estaInscrito) { %>
              <form action="/feiras/<%= feira.id %>/desinscrever" method="POST" style="margin: 0;">
                <button type="submit" class="btn btn-danger">
                  🔔 Inscrito (Cancelar Notificações)
                </button>
              </form>
            <% } else { %>
              <form action="/feiras/<%= feira.id %>/inscrever" method="POST" style="margin: 0;">
                <button type="submit" class="btn btn-primary">
                  🔔 Receber Notificações Desta Feira
                </button>
              </form>
            <% } %>
          <% } else { %>
            <a href="/login" class="btn btn-primary">
              🔔 Entrar para Receber Notificações
            </a>
          <% } %>
        </div>
      </div>

      <div class="detalhes-info-grid">
        <div class="meta-item">
          <span style="font-size: 1.5rem;">📅</span>
          <div>
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Data do Evento</div>
            <strong style="font-size: 1.1rem;"><%= formatDate(feira.data_evento) %></strong>
          </div>
        </div>

        <div class="meta-item">
          <span style="font-size: 1.5rem;">⏰</span>
          <div>
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Horário</div>
            <strong style="font-size: 1.1rem;"><%= feira.horario %></strong>
          </div>
        </div>

        <div class="meta-item">
          <span style="font-size: 1.5rem;">📍</span>
          <div>
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Local</div>
            <strong style="font-size: 1.1rem;"><%= feira.local %></strong>
          </div>
        </div>

        <div class="meta-item">
          <span style="font-size: 1.5rem;">🛍️</span>
          <div>
            <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Tipo de Produtos</div>
            <strong style="font-size: 1.1rem;"><%= feira.tipo_produtos %></strong>
          </div>
        </div>
      </div>

      <div style="margin-top: 2rem;">
        <h3 style="font-size: 1.3rem; margin-bottom: 0.75rem; color: var(--text-primary);">Sobre a Feira</h3>
        <div style="color: var(--text-secondary); line-height: 1.8; font-size: 1.05rem; white-space: pre-line;">
          <%= feira.descricao || 'Nenhuma descrição detalhada fornecida para este evento.' %>
        </div>
      </div>

      <div style="margin-top: 2.5rem; padding: 1.25rem; background: #f8fafc; border-radius: var(--radius-md); border: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
          <strong>Comunidade Fer AL:</strong> 
          <span style="color: var(--text-secondary);"><%= totalInscritos %> <%= totalInscritos === 1 ? 'visitante inscrito' : 'visitantes inscritos' %> para receber atualizações.</span>
        </div>
        <% if (estaInscrito) { %>
          <span style="color: #059669; font-weight: 600;">✓ Você está recebendo alertas sobre este evento</span>
        <% } %>
      </div>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>